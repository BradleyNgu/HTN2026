{
  "name": "htn2026",
  "version": "1.0.0",
  "description": "A private, AI-assisted conversation escape app.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "dev": "concurrently -n mobile,server \"npm:start\" \"npm:server\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BradleyNgu/HTN2026.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/BradleyNgu/HTN2026/issues"
  },
  "homepage": "https://github.com/BradleyNgu/HTN2026#readme",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "expo": "^57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.0",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "openai": "^7.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "~19.2.4",
    "@types/supertest": "^7.2.1",
