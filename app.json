{
  "expo": {
    "name": "TalkBlock",
    "slug": "conversation-escape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "conversationescape",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.htn2026.conversationescape",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "TalkBlock transcribes nearby speech on your device to detect stalled conversations.",
        "NSMicrophoneUsageDescription": "TalkBlock uses your microphone only while you start a listening session."
      }
    },
    "android": {
      "package": "com.htn2026.conversationescape",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TalkBlock to listen while a session is active.",
          "speechRecognitionPermission": "Allow TalkBlock to transcribe speech on this device."
        }
      ],
      "expo-status-bar",
      "expo-audio",
      "./plugins/with-background-listener.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
