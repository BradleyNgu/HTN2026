# Server-only secret. Configure this on Render; never expose it to Expo.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini
PORT=8787

# Optional comma-separated browser origins. Native requests do not send Origin.
ALLOWED_ORIGINS=

# Public HTTPS URL returned by Render, embedded into the Android APK.
EXPO_PUBLIC_API_URL=https://conversation-escape-api.onrender.com
