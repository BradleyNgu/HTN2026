# Server-only secret. Configure this on Render; never expose it to Expo.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini
PORT=8787

# Optional comma-separated browser origins. Native requests do not send Origin.
ALLOWED_ORIGINS=

# Public HTTPS URL returned by Render, embedded into the Android APK.
EXPO_PUBLIC_API_URL=https://conversation-escape-api.onrender.com

# Twilio credentials used by server/interruptions.ts.
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
# Your Twilio-owned caller ID (From). Not the person being called.
# TWILIO_PHONE_NUMBER is still accepted as a fallback alias.
TWILIO_FROM_NUMBER=+15555550123
# Destination numbers chosen by the app's Mom / Boss / Girlfriend alert.
TWILIO_RECIPIENT_MOM=+15555550124
TWILIO_RECIPIENT_BOSS=+15555550125
TWILIO_RECIPIENT_GIRLFRIEND=+15555550126
